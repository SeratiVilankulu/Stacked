// use prisma-8

model User {
  id        Uuid              @id @default(uuid()) @map("Id")
  name      String            @map("Name")
  surname   String            @map("Surname")
  username  String            @map("Username")
  email     String            @map("Email")
  password  String            @map("Password")
  role      UserRole          @map("Role")
  createdAt TimestamptzString @default(now()) @map("CreatedAt")

  admins       Admin[]
  bookCopies   BookCopy[]
  fines        Fine[]
  loanedBooks  LoanedBook[]
  reservations Reservation[]

  @@map("users")
}

model Book {
  id              Uuid    @id @default(uuid()) @map("Id")
  title           String  @map("Title")
  description     String? @map("Description")
  genre           String  @map("Genre")
  author          String  @map("Author")
  isbn            Int?    @map("ISBN")
  coverImageUrl   String? @map("CoverImageURL")
  copiesAvailable Int     @map("CopiesAvailable")

  admins       Admin[]
  bookCopies   BookCopy[]
  loanedBooks  LoanedBook[]
  reservations Reservation[]

  @@map("books")
}

model Admin {
  id     Uuid   @id @default(uuid()) @map("Id")
  userId Uuid   @map("User_Id")
  bookId Uuid   @map("Book_Id")
  name   String @map("Name")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  book Book @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@map("admin")
}

model BookCopy {
  id        Uuid    @id @default(uuid()) @map("Id")
  bookId    Uuid    @map("Book_Id")
  userId    Uuid    @map("User_Id")
  name      String? @map("Name")
  condition BookCondition? @map("Condition")
  status    BookAvailability @map("Status")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("bookcopies")
}

model LoanedBook {
  id         Uuid               @id @default(uuid()) @map("Id")
  bookId     Uuid               @map("Book_id")
  userId     Uuid               @map("User_id")
  loanDate   TimestamptzString  @default(now()) @map("LoanDate")
  dueDate    DateString         @map("ReturnDate")
  returnedAt TimestamptzString? @map("ReturnedAt")
  status     LoanStatus         @map("Status")

  book  Book   @relation(fields: [bookId], references: [id], onDelete: Restrict)
  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  fines Fine[]

  @@map("loanedbooks")
}

model Fine {
  id          Uuid               @id @default(uuid()) @map("Id")
  loanId      Uuid               @map("Loan_Id")
  userId      Uuid               @map("User_Id")
  daysOverDue Int                @map("DaysOverDue")
  amountOwed  Decimal            @map("AmountOwed")
  datePaid    TimestamptzString? @map("DatePaid")

  loan LoanedBook @relation(fields: [loanId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("fines")
}

model Reservation {
  id              Uuid               @id @default(uuid()) @map("Id")
  userId          Uuid               @map("User_Id")
  bookId          Uuid               @map("Book_Id")
  reservationDate TimestamptzString  @default(now()) @map("ReservationDate")
  status          ReservationStatus? @map("Status")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("reservations")
}

// Define enums for select fields
enum UserRole {
  ADMIN
  USER
}

enum BookCondition {
  NEW
  GOOD
  FAIR
  POOR
}

enum BookAvailability {
  AVAILABLE
  LOANED
  RESERVED
}

enum LoanStatus {
  LOANED
  RETURNED
  OVERDUE
}

enum ReservationStatus {
  PENDING
  FULFILLED
  CANCELLED
  EXPIRED
}
