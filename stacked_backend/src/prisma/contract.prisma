// use prisma-8

model User {
  id        Uuid       @id @default(uuid()) @map("Id")
  name      String     @map("Name")
  surname   String     @map("Surname")
  username  String     @map("Username")
  email     String     @map("Email")
  password  String     @map("Password")
  role      String     @map("Role")
  createdAt DateString @map("CreatedAt")

  admins       Admin[]
  bookCopies   BookCopy[]
  fines        Fine[]
  loanedBooks  LoanedBook[]
  reservations Reservation[]

  @@map("users")
}

model Book {
  id              Uuid    @id @default(uuid()) @map("Id")
  title           String  @map("Title")
  description     String? @map("Description")
  genre           String  @map("Genre")
  author          String  @map("Author")
  isbn            Int?    @map("ISBN")
  coverImageUrl   String? @map("CoverImageURL")
  copiesAvailable Int     @map("CopiesAvailable")

  admins       Admin[]
  bookCopies   BookCopy[]
  loanedBooks  LoanedBook[]
  reservations Reservation[]

  @@map("books")
}

model Admin {
  id     Uuid   @id @default(uuid()) @map("Id")
  userId Uuid   @map("User_Id")
  bookId Uuid   @map("Book_Id")
  name   String @map("Name")

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@map("admin")
}

model BookCopy {
  id        Uuid    @id @default(uuid()) @map("Id")
  bookId    Uuid    @map("Book_Id")
  userId    Uuid    @map("User_Id")
  name      String? @map("Name")
  condition String? @map("Condition")
  status    String  @map("Status")

  book Book @relation(fields: [bookId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("bookcopies")
}

model LoanedBook {
  id         Uuid       @id @default(uuid()) @map("Id")
  bookId     Uuid       @map("Book_id")
  userId     Uuid       @map("User_id")
  loanDate   DateString @map("LoanDate")
  returnDate DateString @map("ReturnDate")
  status     String     @map("Status")

  book  Book   @relation(fields: [bookId], references: [id])
  user  User   @relation(fields: [userId], references: [id])
  fines Fine[]

  @@map("loanedbooks")
}

model Fine {
  id          Uuid        @id @default(uuid()) @map("Id")
  loanId      Uuid        @map("Loan_Id")
  userId      Uuid        @map("User_Id")
  daysOverDue Int         @map("DaysOverDue")
  amountOwed  Decimal     @map("AmountOwed")
  datePaid    DateString? @map("DatePaid")

  loan LoanedBook @relation(fields: [loanId], references: [id])
  user User       @relation(fields: [userId], references: [id])

  @@map("fines")
}

model Reservation {
  id              Uuid       @id @default(uuid()) @map("Id")
  userId          Uuid       @map("User_Id")
  bookId          Uuid       @map("Book_Id")
  reservationDate DateString @map("ReservationDate")
  status          String?    @map("Status")

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@map("reservations")
}
